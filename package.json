{
  "name": "profile-bits",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "test": "vitest run",
    "docs": "pnpm --filter @profile-bits/docs build",
    "docs-dev": "pnpm --filter @profile-bits/docs dev",
    "render": "pnpm --filter @profile-bits/cli exec -- tsx --tsconfig tsconfig.runtime.json src/bin.ts render",
    "generate-action": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/core/src/codegen/cli.ts",
    "generate-docs": "node --experimental-strip-types --disable-warning=ExperimentalWarning packages/core/src/codegen/docs-cli.ts",
    "check": "pnpm lint && pnpm test && pnpm generate-action --check && pnpm generate-docs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@fission-ai/openspec": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
