/**
 * Widget fetch: consume the cached {{INTEGRATION_ID}} payload.
 * NO HTTP here (no fetch, octokit, REST /languages, GraphQL).
 * Shared client + cache keys live on the integration:
 *   REST (method, url, params); GraphQL (query, variables).
 *
 * include_private without canPrivate → fail this widget.
 * Do not paint contributions 0 when canContributions is false or viewer ≠ user.
 * Empty language data → caller renders "No language data", not a crash.
 */

export async function fetch{{WIDGET_PASCAL}}(ctx: {
  payload: {{INTEGRATION_PASCAL}}CachedPayload;
  options: {{WIDGET_PASCAL}}Options;
  capabilities: {
    canPrivate: boolean;
    canContributions: boolean;
  };
}): Promise<{{WIDGET_PASCAL}}Payload> {
  const { payload, options, capabilities } = ctx;

  if (options.include_private === true && capabilities.canPrivate !== true) {
    throw new Error("include_private requires canPrivate");
  }

  return mapCachedPayload(payload, options, capabilities);
}

function mapCachedPayload(
  payload: {{INTEGRATION_PASCAL}}CachedPayload,
  options: {{WIDGET_PASCAL}}Options,
  capabilities: { canPrivate: boolean; canContributions: boolean },
): {{WIDGET_PASCAL}}Payload {
  return {
    title:     payload.title,
    subtitle:  payload.subtitle,
    avatarUrl: payload.avatarUrl,
    statLabel: payload.statLabel,
    statValue: payload.statValue,
    chip:      payload.chip,
    barPct:    payload.barPct,
    animate:   options.animate,
    omitContributions: capabilities.canContributions !== true,
  };
}
