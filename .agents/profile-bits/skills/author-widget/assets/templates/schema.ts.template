import * as z from "zod";

/** Option schema for plugins.{{PACK_ID}}.widgets.{{WIDGET_ID}} (yaml SSOT).
 *  Not Action inputs. Never plugin_{{PACK_ID}}_{{WIDGET_ID}}_* names.
 *  Bits are not yaml keys. Public API change → OpenSpec delta first.
 *  bitsUsed: union names into pack-level {{PACK_ID_UPPER}}_BITS_USED on
 *  {{PACK_ID}}Plugin. Not a widget-entry field. Not yaml. */

export const {{WIDGET_PASCAL}}OptionsSchema = z.strictObject({
  filename: z.string().default("{{WIDGET_ID}}"),
  animate:  z.boolean().default(false),
  // github-class widgets add include_private via OpenSpec and fail closed
  // on canPrivate. Do not add it to the generic widget schema:
  // include_private: z.boolean().default(false),
  // md/mdx only — omit on react/html widgets:
  // md: z.strictObject({
  //   presets: z.enum(["default"]).default("default"),
  //   families: z.strictObject({
  //     code:    z.enum(["pretty-code", "starry-night"]).default("pretty-code"),
  //     math:    z.enum(["katex"]).default("katex"),
  //     mermaid: z.enum(["rehype-mermaid"]).default("rehype-mermaid"),
  //     slug:    z.enum(["rehype-slug"]).default("rehype-slug"),
  //     section: z.enum(["rehype-sectionize"]).default("rehype-sectionize"),
  //   }).optional(),
  //   allow_network: z.boolean().default(false),
  // }).optional(),
});

export type {{WIDGET_PASCAL}}Options = z.infer<typeof {{WIDGET_PASCAL}}OptionsSchema>;

export type {{WIDGET_PASCAL}}Payload = {
  title:      string;
  subtitle?:  string;
  avatarUrl?: string;
  statLabel:  string;
  statValue:  string | number;
  chip:       string;
  barPct:     number;
};

export const {{WIDGET_PASCAL}}Formats = [
  "svg",
  "png",
  "jpeg",
  "webp",
  "ico",
  "gif",
  "apng",
] as const;

