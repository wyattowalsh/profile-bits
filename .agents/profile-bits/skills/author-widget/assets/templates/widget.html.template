<!-- Canonical widget.html. Omit `source`. fromHtml via @profile-bits/renderer.
     Takumi-safe: div / span / img only. Card 480×160. Root 100% × 100%.
     Match compiled stylesheets with className. No script, iframe, canvas, foreignObject. -->
<div class="pb-frame" style="width:100%;height:100%">
  <div class="pb-stack">
    <span class="pb-title">{{WIDGET_TITLE}}</span>
    <span class="pb-muted">{{WIDGET_DESCRIPTION}}</span>
    <img class="pb-avatar" alt="" width="32" height="32" src="" />
  </div>
</div>
