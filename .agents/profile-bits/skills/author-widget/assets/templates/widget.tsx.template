import {
  Avatar,
  Bar,
  Chip,
  Divider,
  Frame,
  Muted,
  Row,
  Stack,
  Stat,
  Text,
  Theme,
} from "@profile-bits/bits";
import type { WidgetTheme } from "@profile-bits/renderer";
import type {
  {{WIDGET_PASCAL}}Options,
  {{WIDGET_PASCAL}}Payload,
} from "./schema.js";

/**
 * Takumi-safe React card. Card 480×160. Root width/height 100%.
 * Render via @profile-bits/renderer only (takumi-js 2.9.2).
 * No react-dom, useEffect, portals, Radix/shadcn DOM, or HTTP.
 *
 * Discover as react from canonical widget.tsx — omit `source`.
 */
export function Widget(props: {
  data: {{WIDGET_PASCAL}}Payload;
  options: {{WIDGET_PASCAL}}Options;
  theme: WidgetTheme;
}) {
  const { data, theme } = props;

  return (
    <Theme theme={theme}>
      <Frame>
        <Stack gap={8}>
          <Row gap={8}>
            {typeof data.avatarUrl === "string" && data.avatarUrl.length > 0 ? (
              <Avatar src={data.avatarUrl} size={32} />
            ) : null}
            <Text size={14} weight={600}>
              {data.title}
            </Text>
            <Muted size={12}>{data.subtitle}</Muted>
          </Row>
          <Divider />
          <Row gap={12}>
            <Stat label={data.statLabel} value={data.statValue} />
            <Chip>{data.chip}</Chip>
          </Row>
          <Bar pct={data.barPct} />
        </Stack>
      </Frame>
    </Theme>
  );
}
