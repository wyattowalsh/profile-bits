{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@profile-bits/core": ["../core/src/index.ts"],
      "@profile-bits/integrations": ["../integrations/src/index.ts"],
      "@profile-bits/plugins": ["../plugins/src/index.ts"],
      "@profile-bits/renderer": ["../renderer/src/index.ts"]
    }
  },
  "include": ["src", "tests"]
}
